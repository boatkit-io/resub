{
  "name": "@boatkit-io/resub",
  "version": "2.3.8",
  "description": "A library for writing React components that automatically manage subscriptions to data sources simply by accessing them.",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "clean:dist": "rimraf dist*",
    "build:types": "tsc -p tsconfig/types.json",
    "build:es2015": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig/cjs.json",
    "build": "pnpm run clean:dist && pnpm run lint && pnpm run build:types && pnpm run build:es2015 && pnpm run build:cjs",
    "test": "pnpm run clean:dist && vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm run lint -- --fix"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "react": ">=16.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@types/lodash": "4.17.24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boatkit-io/resub"
  },
  "bugs": {
    "url": "https://github.com/boatkit-io/resub/issues"
  },
  "types": "dist-types/ReSub.d.ts",
  "module": "dist-es2015/ReSub.js",
  "main": "dist/ReSub.js",
  "files": [
    "dist",
    "dist-es2015",
    "dist-types",
    "eslint"
  ],
  "keywords": [
    "react",
    "flux",
    "automatic",
    "subscriptions",
    "stores"
  ],
  "license": "MIT"
}
