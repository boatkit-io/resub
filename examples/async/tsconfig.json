{
  "compilerOptions": {
    "noImplicitReturns": false,
    "noImplicitAny": true,
    "declaration": false,
    "noResolve": false,
    "sourceMap": true,
    "rootDir": "./src",
    "typeRoots": ["node_modules/@types"],
    "module": "commonjs",
    "target": "es2015",
    "outDir": "./dist/",
    "jsx": "react",
    "lib": ["es2015", "dom", "decorators"]
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
